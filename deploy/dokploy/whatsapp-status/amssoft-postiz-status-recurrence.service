[Unit]
Description=Maintain native Postiz WhatsApp Status recurring posts
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/amssoft-postiz-status-automation/recurrence.py
User=root
UMask=0077
TimeoutStartSec=300
MemoryMax=256M
CPUQuota=25%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
